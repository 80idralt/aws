{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SeInstanser",
            "Effect": "Allow",
            "Action": "ec2:Describe*",
            "Resource": "*"
        },
        {
            "Sid": "StyraNovatrixServrar",
            "Effect": "Allow",
            "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:RebootInstances"
            ],
            "Resource": "arn:aws:ec2:eu-north-1:*:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Project": "novatrix"
                }
            }
        }
    ]
}
