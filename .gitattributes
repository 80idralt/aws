.gitattributes text eol=lf
.gitignore     text eol=lf

# Skalskript, user data och allt som körs på Linux-servern måste ha LF.
# Med CRLF kraschar de, t.ex. "bash: $'\r': command not found".
*.sh           text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.py           text eol=lf
*.service      text eol=lf
*.conf         text eol=lf

# CloudFormation-templates och dokumentation, LF håller det konsekvent.
*.json         text eol=lf
*.html         text eol=lf
*.md           text eol=lf

# PowerShell körs på Windows, där CRLF är standard.
*.ps1          text eol=crlf
